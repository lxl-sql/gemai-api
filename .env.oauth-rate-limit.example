# The OAuth queue is disabled by default. Enable it only after validating the
# shared Redis and database capacity; it then reuses REDIS_CONN_STRING and the
# bounded defaults from pkg/oauthqueue/config.go.
# OAUTH_QUEUE_ENABLE=true

# Optional namespace when multiple deployments intentionally share one Redis.
# OAUTH_QUEUE_NAMESPACE=oauth-exchange

# Dedicated Redis Cluster/Sentinel or independent-shard deployments are
# advanced optional topologies documented in the OAuth patch notes.
